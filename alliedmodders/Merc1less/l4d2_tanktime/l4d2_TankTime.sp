public APLRes AskPluginLoad2(Handle myself, bool late, char[] error, int err_max)
{	
	if (GetEngineVersion() != Engine_Left4Dead2)
	{	
		strcopy(error, err_max, "This plugin is written for Left 4 Dead 2.(mutation19)");
		return APLRes_SilentFailure;
	}
	return APLRes_Success;
}

public void OnPluginStart()
{
	LoadTranslations("common.phrases");
	LoadTranslations("l4d2_tanktime.phrases");
	
	CreateConVar("l4d2_tanktime_version",PLUGIN_VERSION,"Version of the plugin",FCVAR_REPLICATED|FCVAR_DONTRECORD|FCVAR_NOTIFY);
	CreateConVar("l4d2_tanktime_gameoptions","55","Flags to enable the avaiable game options",0,true,0.0,true,255.0);
	CreateConVar("l4d2_tanktime_spawntime","15","Spawntime from start",0,true,5.0,true,30.0);
	CreateConVar("l4d2_tanktime_respawntime","30","Respawn time for each tank",0,true,10.0,true,60.0);
	CreateConVar("l4d2_tanktime_tankhealth","0","Sets the default health of a tank"); //added with v1.1.
	CreateConVar("l4d2_tanktime_bigun_limit_per_round","2","Defines the limit of big guns per round."); //added with v1.1
	CreateConVar("l4d2_tanktime_slaycommand","slayme","Slay-command to slay themself");
	CreateConVar("l4d2_tanktime_regulartankcolor","255 0 0 255","Defines the color of the regular tank");
	CreateConVar("l4d2_tanktime_autorestart_command","","Defines a restart command for restarting the server if the game starts too early");
	
	AutoExecConfig(true,"l4d2_tanktime");
	
	HookConVarChange(FindConVar("mp_gamemode"),Hook_GamemodeChanged);
	HookEvent("game_init",Events_GameStatus,EventHookMode_Post);	
	
	//Load the fx
	Handle hConf = LoadGameConfigFile("l4d2_tanktime_addresses");
	
	g_pZombieManager = GameConfGetAddress(hConf, "CZombieManager");	
	if (g_pZombieManager == Address_Null)
		SetFailState("Error: Adress Null");
	
	StartPrepSDKCall(SDKCall_Player);
	PrepSDKCall_SetFromConf(hConf, SDKConf_Signature, "TakeOverZombieBot");
	PrepSDKCall_AddParameter(SDKType_CBasePlayer, SDKPass_Pointer);
	g_hTakeOverZombieBot = EndPrepSDKCall();
	
	StartPrepSDKCall(SDKCall_Raw);
	PrepSDKCall_SetFromConf(hConf, SDKConf_Signature, "ReplaceTank");
	PrepSDKCall_AddParameter(SDKType_CBasePlayer, SDKPass_Pointer);
	PrepSDKCall_AddParameter(SDKType_CBasePlayer, SDKPass_Pointer);
	g_fReplaceTank = EndPrepSDKCall();
	
	if (g_hTakeOverZombieBot == INVALID_HANDLE
	||  g_fReplaceTank		 == INVALID_HANDLE)
		SetFailState("Error : Address Null");
	
	//Init Array
	g_arrGameData = new ArrayList();
	for (int i = 0;i <= GDIDX_TANK_NAMES_LIST;i++)
		g_arrGameData.Push(INVALID_HANDLE);
	
	g_arrGameData.Push(0); //GDIDX_SPAWN_LIMIT		
}

public void Hook_GamemodeChanged (Handle convar, const char[] oldValue, const char[] newValue)
{	
	static bool bHooksEnabled = false;
	//Do we starting a Tank Mutation?
	if (StrEqual(newValue,"mutation19"))
	{
		EnableGameMode(true);
		
		if (!bHooksEnabled)
		{
			//Game Status
			HookEvent("finale_start",Events_GameStatus,EventHookMode_Post); 
			HookEvent("round_start",Events_GameStatus,EventHookMode_Post);		
			HookEvent("round_end",Events_GameStatus,EventHookMode_Post);
			HookEvent("versus_match_finished",Events_GameStatus,EventHookMode_Post);
			HookEvent("versus_round_start",Events_GameStatus,EventHookMode_Post);
			//Is incapped
			HookEvent("player_incapacitated",Events_PlayerIsIncapped,EventHookMode_Post);
			HookEvent("bot_player_replace",Events_PlayerIsIncapped,EventHookMode_Post);					
			//events for tank spawning, players changing teams....
			HookEvent("round_start",Events_TankTime,EventHookMode_Post);
			HookEvent("round_end",Events_TankTime,EventHookMode_Post);
			HookEvent("player_spawn",Events_TankTime,EventHookMode_Pre);		
			HookEvent("versus_round_start",Events_TankTime,EventHookMode_Post);		
			HookEvent("player_team",Events_TankTime,EventHookMode_Post);
			HookEvent("player_death",Events_TankTime,EventHookMode_Post);
			HookEvent("player_bot_replace",Events_TankTime,EventHookMode_Post);			
			//Witch
			HookEvent("witch_spawn",Events_WitchSpawn,EventHookMode_Post);	
			HookEvent("versus_round_start",Events_WitchSpawn,EventHookMode_Post);
			HookEvent("round_start",Events_WitchSpawn,EventHookMode_Post);				
			//shows tank's last hp
			HookEvent("player_incapacitated",Event_PlayerDown,EventHookMode_Post);
			
			//Command Listener for the slayme and info commands
			AddCommandListener(Events_Chat,"say_team");
			AddCommandListener(Events_Chat,"say");
			
			HookUserMessage(GetUserMessageId("VotePass"), VotePass);
			HookUserMessage(GetUserMessageId("VGUIMenu"), Event_VGUIMenu);		
			
			bHooksEnabled = true;			
		}
	}
	else if (bHooksEnabled)
	{
		EnableGameMode(false);
		
		UnhookEvent("player_incapacitated",Event_PlayerDown,EventHookMode_Post);				
		UnhookEvent("finale_start",Events_GameStatus,EventHookMode_Post);
		UnhookEvent("round_start",Events_GameStatus,EventHookMode_Post);		
		UnhookEvent("round_end",Events_GameStatus,EventHookMode_Post);
		UnhookEvent("versus_match_finished",Events_GameStatus,EventHookMode_Post);	
		UnhookEvent("versus_round_start",Events_GameStatus,EventHookMode_Post);		
		UnhookEvent("player_incapacitated",Events_PlayerIsIncapped,EventHookMode_Post);
		UnhookEvent("bot_player_replace",Events_PlayerIsIncapped,EventHookMode_Post);							
		
		UnhookEvent("round_start",Events_TankTime,EventHookMode_Post);
		UnhookEvent("round_end",Events_TankTime,EventHookMode_Post);
		UnhookEvent("player_spawn",Events_TankTime,EventHookMode_Pre);		
		UnhookEvent("versus_round_start",Events_TankTime,EventHookMode_Post);
		UnhookEvent("player_team",Events_TankTime,EventHookMode_Post);
		UnhookEvent("player_death",Events_TankTime,EventHookMode_Post);
		UnhookEvent("player_bot_replace",Events_TankTime,EventHookMode_Post);			
		//Witch
		UnhookEvent("witch_spawn",Events_WitchSpawn,EventHookMode_Post);	
		UnhookEvent("round_start",Events_WitchSpawn,EventHookMode_Post);
		UnhookEvent("versus_round_start",Events_WitchSpawn,EventHookMode_Post);
		
		RemoveCommandListener(Events_Chat,"say_team");
		RemoveCommandListener(Events_Chat,"say");
		
		UnhookUserMessage(GetUserMessageId("VotePass"),VotePass);
		UnhookUserMessage(GetUserMessageId("VGUIMenu"),Event_VGUIMenu);
		
		bHooksEnabled = false;
	}
}
void EnableGameMode (bool bEnable)
{
	if(bEnable)
	{
		if (g_gameoptions > 0)
			return;
		
		//Not changeable DURING a match
		g_gameoptions 		= GetConVarInt   (FindConVar("l4d2_tanktime_gameoptions"));
		SPAWN_TIME		 	= GetConVarFloat (FindConVar("l4d2_tanktime_spawntime"));
		RESPAWN_TIME	 	= GetConVarFloat (FindConVar("l4d2_tanktime_respawntime"));
		cvar_TankHealth 	= GetConVarInt	 (FindConVar("l4d2_tanktime_tankhealth"));
		cvar_Bigguns_limit	= GetConVarInt	 (FindConVar("l4d2_tanktime_bigun_limit_per_round"));
		
		char sTankCol[17];		
		GetConVarString(FindConVar("l4d2_tanktime_regulartankcolor"),sTankCol,sizeof(sTankCol));
		
		char TankCol[4][4];		
		if (ExplodeString(sTankCol," ",TankCol,4,4) == 4)
		{
			for (int c = 0;c < 4;c++)
				REGULAR_TANK_COL[c] = StringToInt(TankCol[c]);
		}
		else //paint it red (default)
			REGULAR_TANK_COL = {255,0,0,255};
		
		GetConVarString(FindConVar("l4d2_tanktime_slaycommand"),SLAY_COMMAND,sizeof(SLAY_COMMAND));
		
		//Is mainly needed since the "great" major update from 07/02/2013. Valve replaced z_spawn to z_spawn_old, so the bots are spawning inside the survivors team / on rochelle's or zoey's head and inside safe rooms...
		SetConVarInt  (FindConVar("director_no_specials"),1);
		SetConVarFloat(FindConVar("versus_tank_flow_team_variation"),0.0);
		///VERY important to disable the tank lottery, since the game engine could kill all tanks
		//Situation: one player is elected to play the tank and currently dead
		//-> some tanks (the elected player included) spawn after the announcment by plugin
		//-> the game engine kills all (mostly) living tanks which are spawned between the announcement and the spawn time of the regular tank
		//-> the elected player can play the regular tank now, but all other tanks are dead or disappear
		SetConVarInt  (FindConVar("director_tank_lottery_selection_time"),0);
		SetConVarFloat(FindConVar("director_tank_lottery_entry_time"),0.0);		
		//increase frustration time for tanks (u should install the tankdoorfix plugin too)
		SetConVarInt(FindConVar("z_frustration_lifetime"),60);			
		
		if (g_gameoptions & GO_FLAG_ENABLE_CRAWLING) //Is crawling enabled?
		{
			SetConVarInt(FindConVar("survivor_allow_crawling"),1);
			SetConVarInt(FindConVar("survivor_crawl_speed"),40);
		}			
		
		float flTankChance = 0.0;		
		if (g_gameoptions & GO_FLAG_FORCE_SI_SPAWN)				
		{	
			flTankChance = 1.0;
			
			SetConVarFloat (FindConVar("versus_witch_chance_intro"),1.0);
			SetConVarFloat (FindConVar("versus_witch_chance"),1.0);	 
			SetConVarFloat (FindConVar("versus_witch_chance_finale"),1.0);	
		}	
		
		if (flTankChance != 0.0 || g_gameoptions & GO_FLAG_DONT_ALLOW_REGULAR_TANKS)
		{			
			SetConVarFloat (FindConVar("director_tank_force_offer"),flTankChance);
			SetConVarFloat (FindConVar("versus_tank_chance_intro"),flTankChance);
			SetConVarFloat (FindConVar("versus_tank_chance"),flTankChance);	
			SetConVarFloat (FindConVar("versus_tank_chance_finale"),flTankChance);
		}	
		SpawnTimer_Init();
		
		g_GameStatus = GAME_STATUS_FIRST_MAP; //Doesn't matter if it is REALLY the first map of a campaign, it's just the 1st map for the plugin
		
		if (GetAClient() > 0) //There are people in the game and the game was started by console?
		{
			//Make the plugin ready - avoids some error messages in the logfiles, because the gamedata file wasn't loaded. But the owner of the server should usually restart if the plugin was fresh installed.			
			OnMapStart();
			Events_GameStatus(view_as<Event>(INVALID_HANDLE),"round_start",false);
			Events_TankTime  (view_as<Event>(INVALID_HANDLE),"round_start",false);			
		}
	}
	else
	{
		if (g_gameoptions == 0)
			return;
		
		SpawnTimer_Stop();		
		
		ResetConVar(FindConVar("z_frustration_lifetime"));
		ResetConVar(FindConVar("director_no_specials"));
		ResetConVar(FindConVar("director_tank_lottery_selection_time"));
		ResetConVar(FindConVar("director_tank_lottery_entry_time"));		
		ResetConVar(FindConVar("versus_tank_flow_team_variation"));
		
		if (g_gameoptions & GO_FLAG_ENABLE_CRAWLING)
		{
			ResetConVar(FindConVar("survivor_allow_crawling"));
			ResetConVar(FindConVar("survivor_crawl_speed"));
		}
		
		if (g_gameoptions & GO_FLAG_FORCE_SI_SPAWN || g_gameoptions & GO_FLAG_DONT_ALLOW_REGULAR_TANKS)				
		{	
			ResetConVar(FindConVar("director_tank_force_offer"))
			ResetConVar(FindConVar("versus_tank_chance_intro"));
			ResetConVar(FindConVar("versus_tank_chance"));	
			ResetConVar(FindConVar("versus_tank_chance_finale"));		
			ResetConVar(FindConVar("versus_witch_chance_intro"));
			ResetConVar(FindConVar("versus_witch_chance"));	 
			ResetConVar(FindConVar("versus_witch_chance_finale"));	
		}
		
		g_gameoptions = g_GameStatus = 0;
		GameData_Free();
	}
}
public void OnMapStart()
{
	if (g_gameoptions == 0)
	{
		char sCurGameMode [11];	
		GetConVarString(FindConVar("mp_gamemode"),sCurGameMode,sizeof(sCurGameMode));
		Hook_GamemodeChanged(INVALID_HANDLE,"",sCurGameMode);
	}
	
	if (g_gameoptions == 0)
		return;
	
	PrefetchSound(SOUND_ROUND_BEGINS);
	PrecacheSound(SOUND_ROUND_BEGINS);		
	WoodCutter_ParseGameFile(g_arrGameData);
	
	if (g_gameoptions & GO_FLAG_ENABLE_SHOTGUN_MODE)
	{
		//Precache shotgun models
		for (int m = 0;m < NUMBER_OF_BIG_GUNS;m++)
		{
			if (!IsModelPrecached(Array_Shotguns_BigGuns[m][3]))
				PrecacheModel    (Array_Shotguns_BigGuns[m][3]);
		}	
		ChangeWeaponSpawns(true);
	}
}

public void OnMapEnd()
{
	if (g_gameoptions == 0)
		return;
	
	ChangeWeaponSpawns(false);
	SpawnTimer_Stop();
	GameData_Free();
	SetGameStatus(0,GAME_STATUS_FIRST_MAP|GAME_STATUS_IN_ROUND|GAME_STATUS_SPAWNING_ALLOWED|GAME_STATUS_IN_FINALE);
}

//by "round_end"
#define ROUND_END							 5 
#define ROUND_END__TEAM_SWAP				 0
#define ROUND_END__ALL_PLAYERS_LEFT_THE_GAME 8
public Action Events_GameStatus (Event event, const char[] name, bool dontBroadcast)
{		
	static int stDoorTimeout = 0;
	if(StrEqual(name,"versus_round_start"))
	{	
		if (L4D_IsIntroRunning ()) //The game starts from time to time too early when a slow loading player has connected from lobby or "newer" pcs have ssd hard-disks installed.
		{
			//Show the warning 3 times
			for (int o = 0;o < 3;o++)
				CPrintToTeam(L4D_TEAM_SURVIVORS,"%s %t",PLUGIN_TAG,"RoundStartedTooEarly");
			
			PrintHintTextToAll("%t","RoundStartedTooEarly");
			
			//Restart the server
			char sRestartCmd [64] = "";
			GetConVarString(FindConVar("l4d2_tanktime_autorestart_command"),sRestartCmd,sizeof(sRestartCmd));
			
			if (strlen(sRestartCmd) == 0) //No restart command was set by admin? Restart by ForceChangeLevel()
			{		
				char sMapName[65]	
				GetCurrentMap(sMapName,sizeof(sMapName));
				ForceChangeLevel(sMapName,"_restart");				
			}
			else
				ServerCommand(sRestartCmd);
			
			return Plugin_Continue;
		}
		
		SetGameStatus(GAME_STATUS_IN_ROUND,0);	
		
		//These both maps don't fire the finale_start event, so let's think the finale has begun (without press-button checks, not necessary in this plugin)
		char sMapName[6];
		GetCurrentMap(sMapName,sizeof(sMapName));		
		if (StrContains(sMapName,"c5m5") == 0 || StrContains(sMapName,"c13m4") == 0)
			SetGameStatus(GAME_STATUS_IN_FINALE,0);
		
		//Starts the spawning counter
		DataPack dpTimerData;
		CreateDataTimer(1.0, Countdown_SpawningTanks, dpTimerData,TIMER_REPEAT|TIMER_FLAG_NO_MAPCHANGE);
		dpTimerData.WriteCell(RoundToZero(SPAWN_TIME));
		
		//Tick, Tock
		EmitSoundToAll(SOUND_ROUND_BEGINS);		
		
		if ((GetTime()-stDoorTimeout) >= GetConVarInt(FindConVar("versus_force_start_time")))
			CPrintToChatAll("%s %t",PLUGIN_TAG,"StartedByTimeout");			
	}
	else if (StrEqual(name,"round_start"))
	{		
		stDoorTimeout = GetTime();		
		EnableGameMode(true);		
		
		//Map has routing information? Stripper must be installed!
		if (FindEntityByTargetName("logic_director_query","map_has_routing") != -1)
			CreateTimer(1.0,Timer_Relay);
		
		if (g_gameoptions & GO_FLAG_ENABLE_SHOTGUN_MODE && !L4D_IsFirstRound())
			ChangeWeaponSpawns(true);		
	}
	else if (StrEqual(name,"round_end")) 
	{		
		int iReason = event.GetInt("reason");	
		if (iReason == ROUND_END__TEAM_SWAP)
		{
			if (CheckGameStatus(GAME_STATUS_IN_FINALE))
			{	
				//Bug fixing for Valve to avoid stucked views after a team swapping in a finale of a map after the extro. This bug is solved for many years for z_spawn but not z_spawn_old.
				//This works much better than the old crap code and was inspired by that plugin : https://forums.alliedmods.net/showthread.php?t=321993
				char sName[64],sBuffer[128];
				
				int ent = FindEntityByClassname(-1, "info_director");
				if (ent > -1)
				{					
					GetEntPropString(ent, Prop_Data, "m_iName", sName, sizeof(sName));					
					FormatEx(sBuffer, sizeof(sBuffer), "OnUser1 %s:ReleaseSurvivorPositions::0:-1", sName);
					SetVariantString(sBuffer);
					AcceptEntityInput(ent, "AddOutput");
					FormatEx(sBuffer, sizeof(sBuffer), "OnUser1 %s:FinishIntro::0:-1", sName);
					SetVariantString(sBuffer);
					AcceptEntityInput(ent, "AddOutput");
					AcceptEntityInput(ent, "FireUser1");
				}		
				
				if ((ent = FindEntityByClassname(-1, "point_viewcontrol_multiplayer")) > -1)
				{
					GetEntPropString(ent, Prop_Data, "m_iName", sName, sizeof(sName));
					Format(sBuffer, sizeof(sBuffer), "OnUser2 %s:StartMovement::0:-1", sName);
					SetVariantString(sBuffer);
					AcceptEntityInput(ent, "AddOutput");
					AcceptEntityInput(ent, "FireUser2");
				}
				
			}	
			SetGameStatus(0,GAME_STATUS_IN_ROUND|GAME_STATUS_SPAWNING_ALLOWED|GAME_STATUS_IN_FINALE);
		}
		else if (iReason == ROUND_END)
		{
			if (IsVoteInProgress ())
				CancelVote();			
			
			SetGameStatus(0,GAME_STATUS_IN_ROUND);			
		}
		else if (iReason == ROUND_END__ALL_PLAYERS_LEFT_THE_GAME)
		{
			EnableGameMode(false);			
		}			
	}
	else if (StrEqual(name,"finale_start"))
	{
		SetGameStatus(GAME_STATUS_IN_FINALE,0);
		
		//Inform all players about the current spawn limits
		if (view_as<bool>(g_arrGameData.Get(GDIDX_SPAWN_LIMIT_AT_FINALE))) //a spawn limit has begun
		{						
			SetGameStatus(GAME_STATUS_SPAWN_LIMIT,0);
			
			if (GetHumanTankCount() < MAX_TANK_PLAYERS)
				CPrintToChatAll("%s %t",PLUGIN_TAG,"SpawnLimitInfo_Finale");
		}
	}
	else //versus_match_finished, game_init
		EnableGameMode(false);
	
	return Plugin_Continue;
}

public Action Timer_Relay (Handle timer, int iNull)
{	
	int entRelay  = FindEntityByTargetName("logic_relay","relay_tt_mutation19");
	if (entRelay != -1)	
	{
		SetVariantString("OnUser1 relay_tt_mutation19:Trigger::0:-1");
		AcceptEntityInput(entRelay, "AddOutput");
		AcceptEntityInput(entRelay, "FireUser1");
	}
	return Plugin_Stop;

}
#define VOTE_PASSED_MISSION_CHANGE  "#L4D_vote_passed_mission_change"
#define VOTE_PASSED_RESTART			"#L4D_vote_passed_versus_level_restart"
public Action VotePass (UserMsg msg_id, Handle hBf, const int[] players, int playersNum, bool reliable, bool init)
{
	char whatpassed [64];	
	BfReadByte(hBf); //skip first byte
	BfReadString(hBf,whatpassed,sizeof(whatpassed));
	
	if 		(StrEqual(whatpassed,VOTE_PASSED_MISSION_CHANGE)) EnableGameMode(false);
	else if (StrEqual(whatpassed,VOTE_PASSED_RESTART))		  SetGameStatus(0,GAME_STATUS_IN_FINALE|GAME_STATUS_IN_ROUND|GAME_STATUS_SPAWNING_ALLOWED);	
	
	return Plugin_Continue;
}
public Action Event_PlayerDown (Event event, const char[] name, bool dontBroadcast)
{	
	if (!(g_gameoptions & GO_FLAG_HEALTH_INFO)
		||  !CheckGameStatus(GAME_STATUS_SPAWNING_ALLOWED))
	return Plugin_Continue;
	
	int iDeadPlayersId = GetClientOfUserId(event.GetInt("userid"));		
	if (iDeadPlayersId == 0 || IsFakeClient(iDeadPlayersId) || GetClientTeam(iDeadPlayersId) != L4D_TEAM_SURVIVORS)
		return Plugin_Continue;
	
	int iAttackersClientId = GetClientOfUserId(event.GetInt("attacker"));	
	if (iAttackersClientId == 0 || GetClientTeam(iAttackersClientId) != L4D_TEAM_INFECTED)
		return Plugin_Continue;		
	
	CPrintToChatEx(iDeadPlayersId,iAttackersClientId,"%s %t",PLUGIN_TAG,"Survivor_WasIncappedBy",iAttackersClientId,GetEntProp(iAttackersClientId,Prop_Data,"m_iHealth"));	
	return Plugin_Continue;
}
//shows a hud panel (left side) with some information which tank is hunting you (survivors) OR who is the tank player in the infected team and how much hp does it has
public Action Timer_ShowHud (Handle timer, Handle hndl)
{ 
	for (int p = 1;p <= MaxClients;p++)
	{
		if (IsClientInGame(p) && !IsFakeClient(p) && GetClientMenu(p) != MenuSource_Normal)
		{
			int targetId = GetClientAimTarget(p,true);
			if (targetId > -1 && GetClientTeam(targetId) == L4D_TEAM_INFECTED && !IsVoteInProgress())
			{		
				int psTeam = GetClientTeam(p);
				if (psTeam == L4D_TEAM_SURVIVORS)
				{
					char sIsRegular[32];
					if (RegularTankId() == GetClientUserId(targetId))
						Format(sIsRegular,sizeof(sIsRegular),"(%T)","IsRegular",p);
					else
						sIsRegular[0] = '\0';
					
					DisplayPanelText(p,"Tank%s : %N",sIsRegular,targetId);
				}
				else if (psTeam == L4D_TEAM_INFECTED)
					DisplayPanelText(p,"Tank : %N (HP: %d)",targetId,GetEntProp(targetId,Prop_Data,"m_iHealth"));
			}
		}
	}
	return Plugin_Continue;
}
void DisplayPanelText(int client, char[] sMessage, any ...)
{
	char sPanelText[256];
	VFormat(sPanelText,sizeof(sPanelText),sMessage,3);
	
	Handle hPanel = CreatePanel();				
	DrawPanelText(hPanel,sPanelText);
	SendPanelToClient(hPanel,client,Menu_PanelHandler,1);
}
public int Menu_PanelHandler(Handle menu, MenuAction action, int param1, int param2)
{
	//Nothing to do
	return 0;
}
//Just big guns against the tanks. 
void ChangeWeaponSpawns (bool bLoad)
{
	static DataPack dpWeps_1stRound = view_as<DataPack>(INVALID_HANDLE);
	
	if (!bLoad)
	{
		if (dpWeps_1stRound != INVALID_HANDLE)
		{
			CloseHandle(dpWeps_1stRound);
			dpWeps_1stRound = view_as<DataPack>(INVALID_HANDLE);
		}	
		return;
	}
	
	float flOrigin[3], flAngles[3];	
	char sClassName[256];
	int  nItems = 0;
	
	bool bFirstRound = L4D_IsFirstRound();	
	if  (bFirstRound)
	{
		if (dpWeps_1stRound != INVALID_HANDLE)
			dpWeps_1stRound.Reset(true);
		else
			dpWeps_1stRound = new DataPack();
		
		dpWeps_1stRound.WriteCell(0); //Make some space for nItems
	}
	else if (dpWeps_1stRound == INVALID_HANDLE)
		return;
	
	int iBigGunsLimit = 0;
	for (int e = 0, iEntCnt = GetEntityCount();e < iEntCnt;e++)
	{
		if (!IsValidEntity(e))
			continue;
		
		GetEntityClassname(e,sClassName,sizeof(sClassName));
		
		for (int w = 0;w < NUMBER_OF_GUNS;w++)			
		{				
			if (StrEqual(sClassName,Array_WeaponList[w][9]))
			{						
				int WeaponIdx = -1;	
				if (w == 0) //"weapon_spawn" -> could mean everything
				{
					int OldWeaponId = GetEntProp(e, Prop_Send, "m_weaponID");						
					if (OldWeaponId == 0)
						continue;
					
					for (int wId = 1;wId < NUMBER_OF_GUNS;wId++) //Compare by weaponId
					{
						if (OldWeaponId == StringToInt(Array_WeaponList[wId]))
						{
							WeaponIdx = wId;
							break;
						}							
					}	
					if (WeaponIdx == -1)
						continue;
				}
				else
					WeaponIdx = w;
				
				//ignore Tier 1 weps?
				if (!((g_gameoptions & GO_FLAG_SGM_IGNORE_TIER_1) && WeaponIdx < Tier2Weapons_StartIdx))
				{				
					if (bFirstRound)
					{						
						//Replace weapon by a shotgun or a big gun
						if (iBigGunsLimit >= cvar_Bigguns_limit || CheckGameStatus(GAME_STATUS_FIRST_MAP) || WeaponIdx < Tier2Weapons_StartIdx)
							WeaponIdx = GetRandomInt(0,BigGuns_StartIdx-1);
						else
						{
							WeaponIdx = GetRandomInt(0,NUMBER_OF_BIG_GUNS-1);			
							
							if (WeaponIdx >= BigGuns_StartIdx)
								iBigGunsLimit++;
						}
						
						GetEntPropVector(e, Prop_Send, "m_vecOrigin", flOrigin);
						GetEntPropVector(e, Prop_Send, "m_angRotation",flAngles);
						
						//Save origins and angles from the original entity
						dpWeps_1stRound.WriteFloat(flOrigin[0]);
						dpWeps_1stRound.WriteFloat(flOrigin[1]);
						dpWeps_1stRound.WriteFloat(flOrigin[2]);
						
						dpWeps_1stRound.WriteFloat(flAngles[0]);
						dpWeps_1stRound.WriteFloat(flAngles[1]);
						dpWeps_1stRound.WriteFloat(flAngles[2]);
						
						dpWeps_1stRound.WriteCell (WeaponIdx);
						
						DataPackPos LastPos = dpWeps_1stRound.Position;
						dpWeps_1stRound.Reset();
						dpWeps_1stRound.WriteCell(++nItems);
						dpWeps_1stRound.Position = LastPos;
						SpawnWeaponSpot(WeaponIdx,flOrigin,flAngles);
					}				
					AcceptEntityInput(e,"kill"); //just remove the entity in the 2nd round
				}				
				break;
			}
		}		
	}
	
	if (!bFirstRound)
	{	
		//Now create the weapon spawns like the first round with the same weapon ids
		float ObjOrigin[3];
		float ObjAngles[3];
		int WepId = 0;
		
		dpWeps_1stRound.Reset();
		nItems = dpWeps_1stRound.ReadCell();
		
		for (int wSpawn = 0;wSpawn < nItems;wSpawn++)
		{	
			ObjOrigin[0] = dpWeps_1stRound.ReadFloat();
			ObjOrigin[1] = dpWeps_1stRound.ReadFloat();
			ObjOrigin[2] = dpWeps_1stRound.ReadFloat();
			
			ObjAngles[0] = dpWeps_1stRound.ReadFloat();
			ObjAngles[1] = dpWeps_1stRound.ReadFloat();
			ObjAngles[2] = dpWeps_1stRound.ReadFloat();
			
			WepId = dpWeps_1stRound.ReadCell();	
			SpawnWeaponSpot(WepId,ObjOrigin,ObjAngles);
		}	
		CloseHandle(dpWeps_1stRound);
		dpWeps_1stRound = view_as<DataPack>(INVALID_HANDLE);
	}
}
bool SpawnWeaponSpot(int WepIdx, const float flOrigin[3], const float flAngles[3])
{
	int NewWeaponSpot = CreateEntityByName("weapon_spawn");	
	if(IsValidEntity(NewWeaponSpot))
	{	
		if (WepIdx >= BigGuns_StartIdx)
			DispatchKeyValue(NewWeaponSpot, "count", "1"); //Big Guns = one per round and per place
		else
		{
			char sMaxWeaponsPerSpawn[3];			
			IntToString(MAX_TANK_PLAYERS,sMaxWeaponsPerSpawn,sizeof(sMaxWeaponsPerSpawn))
			DispatchKeyValue(NewWeaponSpot, "count",sMaxWeaponsPerSpawn); 
		}
		SetEntProp(NewWeaponSpot, Prop_Send, "m_weaponID",StringToInt(Array_Shotguns_BigGuns[WepIdx]));
		SetEntityModel(NewWeaponSpot,Array_Shotguns_BigGuns[WepIdx][3]);
		TeleportEntity(NewWeaponSpot, flOrigin, flAngles, NULL_VECTOR);						
		return DispatchSpawn(NewWeaponSpot);
	}
	return false;
}
//TANK TIMERS AND SPAWNING STUFF- seems to be necessary since the july 2013 update
public Action Countdown_SpawningTanks (Handle timer, DataPack dpTimerData)
{	
	if (!CheckGameStatus(GAME_STATUS_IN_ROUND))
		return Plugin_Stop;
	
	dpTimerData.Reset();	
	int nTicks = dpTimerData.ReadCell() - 1;
	if (nTicks == 0) //SPAWN TIME!
	{
		//"Fire" our own event on the easiest way
		Events_TankTime(view_as<Event>(INVALID_HANDLE),"spawn_time",false);
		
		//Inform all players about the countdown
		PrintHintTextToAll("%t","TanksAreSpawningNow");	
		return Plugin_Stop;
	}
	else if (nTicks == 10) 
	{
		//tell the first infected team in the game that the plugin is installed on server
		if (L4D_IsFirstRound())
			CPrintToTeam(L4D_TEAM_INFECTED,"%s %t",PLUGIN_TAG,"TankTimeInfo");
		
		//show all infected players who translated the plugin messages into their language - but just in the very 1st round
		if (CheckGameStatus(GAME_STATUS_FIRST_MAP))
			CPrintToTeam(L4D_TEAM_INFECTED,"%s %t",PLUGIN_TAG,"PhrasesAuthor");	
	}
	
	//update the counter
	PrintHintTextToAll("%t","TanksAreSpawningIn",nTicks);
	
	//Update ticks
	dpTimerData.Reset();
	dpTimerData.WriteCell(nTicks);	
	return Plugin_Continue;
}

int g_SpawnTimersCount = 0;
void SpawnTimer_Init ()
{
	g_SpawnTimersCount = 0;	
	
	for (int t = 0;t < MAX_TANK_PLAYERS;t++)
		g_arrSpawnTimers[t].Init();
}
void SpawnTimer_Stop()
{
	for (int t = 0,iLen = MAX_TANK_PLAYERS;t < iLen;t++)
	{
		if (g_arrSpawnTimers[t].hTimer != INVALID_HANDLE)
			KillTimer(g_arrSpawnTimers[t].hTimer);
		
		g_arrSpawnTimers[t].Init();
	}
	g_SpawnTimersCount = 0;
}
int SpawnTimer_GetSpawnTime (int userId)
{
	int     iIndex = SpawnTimer_FindPlayersTimer(userId);
	return (iIndex > -1 ? g_arrSpawnTimers[iIndex].iSeconds : 0);
}
bool SpawnTimer_UnassignPlayerFromTimer (int userId)
{	
	int iTimerId = SpawnTimer_FindPlayersTimer(userId);
	if (iTimerId == -1)
		return false;
	
	g_arrSpawnTimers[iTimerId].iUserId = 0; //is now a timer for a bot
	return true;
}
int SpawnTimer_GetRunningTimersCount()
{
	return g_SpawnTimersCount;
}
//would be a private function
int SpawnTimer_FindPlayersTimer(int userId)
{
	if (userId == 0)
		return -1;
	
	for (int t = 0;t < MAX_TANK_PLAYERS;t++)
	{
		if (g_arrSpawnTimers[t].iUserId == userId)
			return t;		
	}
	return -1;
}
#define ASSIGN_PLAYER_TO_BOT_TIMER 0.1
bool SpawnTimer_Create (float flTimer, int userId = 0)
{
	if (!CheckGameStatus(GAME_STATUS_SPAWNING_ALLOWED))
		return false;
	
	if (userId == 0 && g_SpawnTimersCount == MAX_TANK_PLAYERS)
		return false;
	
	int iLowestSeconds = RoundFloat(RESPAWN_TIME);
	int iBotTimerIndex = -1, FreeSlotIndex  = -1;
	
	//Look for a bot with the lowest seconds value and look for a free slot too
	for (int t = MAX_TANK_PLAYERS-1;t > -1;t--)
	{
		if (g_arrSpawnTimers[t].iSlotIndex > -1)
		{
			if (userId > 0 && g_arrSpawnTimers[t].iUserId == 0 || GetClientOfUserId(g_arrSpawnTimers[t].iUserId) == 0)
			{
				if (g_arrSpawnTimers[t].iSeconds < iLowestSeconds)
				{
					iBotTimerIndex = t;
					iLowestSeconds = g_arrSpawnTimers[t].iSeconds;
				}
			}
		}
		else
			FreeSlotIndex = t;	
	}
	
	if (userId > 0)//Assign a human to a bot timer
	{		
		if (iBotTimerIndex > -1)
		{
			//Overwrite userid
			g_arrSpawnTimers[iBotTimerIndex].iUserId = userId;			
			if (flTimer == ASSIGN_PLAYER_TO_BOT_TIMER)
				return true;
			
			userId = 0; //let a bot spawn instead of the player. The bot itself 'waits' the full amount of time
		}	
		
		if (flTimer == ASSIGN_PLAYER_TO_BOT_TIMER)
			flTimer = RESPAWN_TIME;		
	}
	
	//Reduce the amount of spawn time when a spawn limit is set	
	if (CheckGameStatus(GAME_STATUS_SPAWN_LIMIT))
	{
		int nPlayers = GetHumanTankCount();
		if (nPlayers == 0)
			nPlayers = 1; //one bot tank is allowed in finales by engine
		
		flTimer = (RESPAWN_TIME / float(MAX_TANK_PLAYERS)) * float(nPlayers);
	}
	
	g_arrSpawnTimers[FreeSlotIndex].iSlotIndex = FreeSlotIndex;	
	g_arrSpawnTimers[FreeSlotIndex].iUserId	   = userId;
	g_arrSpawnTimers[FreeSlotIndex].iSeconds   = RoundToZero(flTimer);	
	g_arrSpawnTimers[FreeSlotIndex].hTimer     = CreateTimer(1.0,SpawnTimer_Countdown,FreeSlotIndex,TIMER_REPEAT|TIMER_FLAG_NO_MAPCHANGE);		
	g_SpawnTimersCount++;
	return true;
}
//Shows a human player their own countdown
public Action SpawnTimer_Countdown (Handle timer, int iSlotIdx)
{	
	g_arrSpawnTimers[iSlotIdx].iSeconds -= 1;
	
	if (!CheckGameStatus(GAME_STATUS_SPAWNING_ALLOWED) || !CheckGameStatus(GAME_STATUS_IN_ROUND))
	{	
		g_SpawnTimersCount--;
		KillTimer(g_arrSpawnTimers[iSlotIdx].hTimer);
		g_arrSpawnTimers[iSlotIdx].Init();
		return Plugin_Stop;
	}
	else if (g_arrSpawnTimers[iSlotIdx].iSeconds == 0) //time to spawn
	{
		g_SpawnTimersCount--;
		KillTimer(g_arrSpawnTimers[iSlotIdx].hTimer);
		g_arrSpawnTimers[iSlotIdx].Init();		
		CreateTanks();	
		return Plugin_Stop;
	}
	else if (g_arrSpawnTimers[iSlotIdx].iUserId > 0) //shows the counter, if it is a human player
	{
		int clientId = GetClientOfUserId(g_arrSpawnTimers[iSlotIdx].iUserId);
		if (clientId > 0 && !IsPlayerAlive(clientId) && GetClientTeam(clientId) == L4D_TEAM_INFECTED) //Check if the player is still in the right team and playing on the server
			PrintHintText(clientId,"%t","YouAreSpawningIn",g_arrSpawnTimers[iSlotIdx].iSeconds);
		else
			g_arrSpawnTimers[iSlotIdx].iUserId = 0;
	}
	return Plugin_Continue;
}
int GetLivingTanksCount() 
{
	int iTanks = 0;
	for (int i = 1;i <= MaxClients;i++)
	{
		if (IsClientInGame(i) && GetClientTeam(i) == L4D_TEAM_INFECTED && IsPlayerAlive(i))
			iTanks++;
	}
	return iTanks;
}	
int GetHumanTankCount()
{
	int iHumanCount = 0;
	for (int i = 1;i <= MaxClients;i++)
	{
		if (IsClientInGame(i) && !IsFakeClient(i) && GetClientTeam(i) == L4D_TEAM_INFECTED)
			iHumanCount++;	
	}
	return iHumanCount;
}

bool CreateTanks (int nCount = 1, bool bNoAutoSpawn = false)
{	
	if (nCount == 0 || !CheckGameStatus(GAME_STATUS_SPAWNING_ALLOWED) || !CheckGameStatus(GAME_STATUS_IN_ROUND))
		return false;
	
	int iFakeClient = GetAClient();
	if (iFakeClient == 0)
		return false;
	
	char sSpawnCmd[12];
	sSpawnCmd = bNoAutoSpawn ? "z_spawn" : "z_spawn_old";
	
	int CommandFlags = GetCommandFlags(sSpawnCmd);	
	SetCommandFlags(sSpawnCmd, CommandFlags ^ FCVAR_CHEAT);
	
	char   sSpawnStr[32];
	Format(sSpawnStr,sizeof(sSpawnStr),"%s tank%s",sSpawnCmd,bNoAutoSpawn ? "" : " auto");
	
	int iBotsToSpawn = nCount, iLastCount = GetLivingTanksCount(), iCurCount = 0;
	
	for (int r = 0; r < 2;r++)
	{	
		for (int i = 0;i < nCount && iBotsToSpawn > 0 && CheckGameStatus(GAME_STATUS_SPAWNING_ALLOWED);i++)
		{
			FakeClientCommand(iFakeClient,sSpawnStr);		
			if ((iCurCount = GetLivingTanksCount()) > iLastCount)
			{
				iLastCount = iCurCount;
				iBotsToSpawn--;
			}			
		}		
		if (iBotsToSpawn <= 0)
			break;
		
		sSpawnStr[16] = '\0'; //second loop: try it without the 'auto' param again. The tank could spawn in front of you or on your head, but this is needed for small map areas / small floors.
	}
	SetCommandFlags(sSpawnCmd,CommandFlags);	
	return true;
}
void TeleportTank (int userId, float flToOrigin[3])
{
	ArrayList arrFrameData = new ArrayList();
	
	arrFrameData.Push (userId);
	arrFrameData.Push (flToOrigin[0]);
	arrFrameData.Push (flToOrigin[1]);
	arrFrameData.Push (flToOrigin[2]);	
	RequestFrame(NextFrame_TeleportTank,arrFrameData);
}
void NextFrame_TeleportTank (ArrayList arrFrameData)
{
	int clientId = GetClientOfUserId(arrFrameData.Get(0));	
	if (clientId == 0)
		return;
	
	float vecToOrigin[3];
	arrFrameData.GetArray(1,vecToOrigin[0]);
	arrFrameData.GetArray(2,vecToOrigin[1]);
	arrFrameData.GetArray(3,vecToOrigin[2]);
	TeleportEntity(clientId,vecToOrigin,NULL_VECTOR,NULL_VECTOR);	
	delete arrFrameData;	
}

public Action Events_TankTime (Event event, const char[] name, bool dontBroadcast)
{
	static float flSavedFirstSpawns [MAX_TANK_PLAYERS][3];
	static int   stFirstSpawnIndex = 0;	
	int iUserId;
	
	if (StrEqual(name,"player_spawn"))
	{	
		if (!CheckGameStatus(GAME_STATUS_IN_ROUND))
			return Plugin_Continue;
		
		iUserId = event.GetInt("userid");	
		int clientId = GetClientOfUserId(iUserId);
		if (clientId == 0 || GetClientTeam(clientId) != L4D_TEAM_INFECTED) 
			return Plugin_Continue;
		
		float flSpawnPos[3];
		GetEntPropVector(clientId, Prop_Send, "m_vecOrigin", flSpawnPos);		
		
		if (flSpawnPos[0] == 0.0 && flSpawnPos[1] == 0.0) //happens while player_bot_replace / bot_player_replace events which comes as player_spawn event too
			return Plugin_Continue;		
		
		bool bBotTank = IsFakeClient(clientId);		
		if (!bBotTank)
		{			
			//Player spawned too early? Another player should spawn now. Cannot handle with z_spawn_old which dead player will control the new spawned tank.
			if (SpawnTimer_GetSpawnTime(iUserId) > 0)
			{
				for (int p = 1;p <= MaxClients;p++)
				{
					if (p != clientId && IsClientInGame(p) && !IsFakeClient(p) && !IsPlayerAlive(p) && GetClientTeam(p) == L4D_TEAM_INFECTED && SpawnTimer_GetSpawnTime(GetClientUserId(p)) == 0)
					{
						UnhookEvent("player_death",Events_TankTime,EventHookMode_Post);	//Event is called by ReplaceTank()
						SDKCall(g_fReplaceTank, g_pZombieManager, clientId, p);						
						HookEvent("player_death",Events_TankTime,EventHookMode_Post);
						return Plugin_Continue;
					}
				}
			}
		}
		else 
		{ 
			//will not happen when a spawn limit is set by valve! a human player could spawn some earlier, but an additional bot will not be spawned by engine
			if (RegularTankId() == -1 
			&& (!CheckGameStatus(GAME_STATUS_SPAWNING_ALLOWED) || !(g_gameoptions & GO_FLAG_ENABLE_BOTS) || (GetLivingTanksCount() + SpawnTimer_GetRunningTimersCount() > MAX_TANK_PLAYERS)))
			{					
				if (!(g_gameoptions & GO_FLAG_DONT_ALLOW_REGULAR_TANKS))
				{
					RegularTankId(iUserId);
					CPrintToChatAll("%s %t",PLUGIN_TAG,"RegularTankIsSpawningNow");//Inform all players about the regular tank (to avoid aggrrrressions)
				}
				else
					ForcePlayerSuicide(GetClientOfUserId(iUserId)); //some regular tanks will spawn in cold stream and are not allowed here
				
				return Plugin_Continue;
			}			
			ChangeTanksName(clientId);
		}
		
		//Check for a spawn limit and give the tanks some extra health (power of 4 tanks divided of n-human players in the team)
		if (CheckGameStatus(GAME_STATUS_SPAWN_LIMIT))
		{	
			int HumanTanks = GetHumanTankCount();//<- some bot tanks could still alive since map start
			if (HumanTanks < MAX_TANK_PLAYERS)	
			{
				if (HumanTanks == 0)
					HumanTanks = 1; //just bot tank(s) in the game
				
				float flTanksHealth = RoundToZero(float(cvar_TankHealth > 0 ? cvar_TankHealth : GetConVarInt (FindConVar("z_tank_health"))) * MAX_TANK_PLAYERS) / float(HumanTanks);			
				SetEntProp(clientId,Prop_Data,"m_iMaxHealth",flTanksHealth);
				SetEntProp(clientId,Prop_Data,"m_iHealth",flTanksHealth);						
			}
		}
		else if (cvar_TankHealth > 0)
		{
			SetEntProp(clientId,Prop_Data,"m_iMaxHealth",cvar_TankHealth);
			SetEntProp(clientId,Prop_Data,"m_iHealth",cvar_TankHealth);	
		}
		
		//First spawn in this round?
		if (stFirstSpawnIndex < MAX_TANK_PLAYERS) 
		{				
			if (L4D_IsFirstRound()) //Save Vectors and teleport the tank, if needed
			{		
				//Try it first with fixed spawn positions (if set in the l4d2_tanktime.txt file)
				ArrayList arrFixedSpawns;
				if ((arrFixedSpawns = FixedSpawnsAtStart()) != INVALID_HANDLE)
				{
					//Read a random spawn position from list					
					int RandomIndex = (GetRandomInt(0,((arrFixedSpawns.Length / 3)-1))*3);
					
					for (int v = 0;v < 3;v++)
						flSavedFirstSpawns [stFirstSpawnIndex][v] = view_as<float>(arrFixedSpawns.Get(RandomIndex++));
					
					TeleportTank(iUserId,flSavedFirstSpawns[stFirstSpawnIndex]);
				}
				else //just save the vectors 
				{				
					if (g_arrGameData.Get(GDIDX_BUGGED_AREAS_LIST) != INVALID_HANDLE) //Is a bugged spawn area?
					{
						if (CheckVectorByBugList(g_arrGameData.Get(GDIDX_BUGGED_AREAS_LIST),flSpawnPos))
							TeleportTank(iUserId,flSpawnPos);						
					}
					for (int v = 0;v < 3;v++)
						flSavedFirstSpawns [stFirstSpawnIndex][v] = flSpawnPos[v];
				}
			}
			else
			{
				//0.0 happens with spawn limits at round start (Team 1 has 2 human players, Team 2 has 3 human players -> a vector for the 3rd player wasn't saved before)
				if (flSavedFirstSpawns[stFirstSpawnIndex][0] != 0.0) 
					TeleportTank(iUserId,flSavedFirstSpawns[stFirstSpawnIndex]);				
			}	
			stFirstSpawnIndex++;
		}
		else 
		{
			//Check with every spawn for a bugged area, if it is not a bot. Bots are always find their right way.
			if (g_arrGameData.Get(GDIDX_BUGGED_AREAS_LIST) != INVALID_HANDLE && !bBotTank
			&&  CheckVectorByBugList(g_arrGameData.Get(GDIDX_BUGGED_AREAS_LIST),flSpawnPos)) 
				TeleportTank(clientId,flSpawnPos);
		}
		return Plugin_Continue;
	}
	else if(StrEqual(name,"player_death"))
	{
		if (!CheckGameStatus(GAME_STATUS_SPAWNING_ALLOWED)) 
			return Plugin_Continue;		 
		
		iUserId = event.GetInt("userid");
		int killedTankId = GetClientOfUserId(iUserId);		
		if (killedTankId == 0 || GetClientTeam(killedTankId) != L4D_TEAM_INFECTED)
			return Plugin_Continue;		
		
		if (RegularTankId() == iUserId)
			RegularTankId(0);
		
		if (IsFakeClient(killedTankId))
		{				
			if (g_gameoptions & GO_FLAG_ENABLE_BOTS
			&& !((GetLivingTanksCount()+1) + SpawnTimer_GetRunningTimersCount() > MAX_TANK_PLAYERS)) //use GetLivingTanksCount() instead of GetTeamClientCount() 
				SpawnTimer_Create(RESPAWN_TIME); //add to loop
		}
		else
		{		
			if (GetLivingTanksCount() >= MAX_TANK_PLAYERS)
				RequestFrame(NextFrame_ReplaceTankBot,iUserId);		
			else 
				SpawnTimer_Create(RESPAWN_TIME,iUserId);		
		}
	}
	//self defined 'event' -> situations: one regular human tank appears while the countdown is running and no other human players are in the infected team
	//OR there are no human players in the team (servers without a shutdown option (sb_all_bot_game 1 enabled) / training)
	else if (StrEqual(name,"spawn_time")) 
	{
		SetGameStatus(GAME_STATUS_SPAWNING_ALLOWED,0);
		
		bool bFixedSpawnPoints = (FixedSpawnsAtStart() != INVALID_HANDLE);
		if (!(g_gameoptions & GO_FLAG_ENABLE_BOTS))
		{
			int HumanTanks = GetTeamClientCount(L4D_TEAM_INFECTED);
			if (HumanTanks > 0)
				CreateTanks(HumanTanks,bFixedSpawnPoints);						
		}
		else
			CreateTanks(MAX_TANK_PLAYERS,bFixedSpawnPoints);		
		
		stFirstSpawnIndex = MAX_TANK_PLAYERS; //first Spawning round is done, but maybe not with 4 players...		
		if (g_gameoptions & GO_FLAG_ENABLE_HUD) //Enable HUD now, if enabled in config
			CreateTimer(0.3,Timer_ShowHud,INVALID_HANDLE,TIMER_FLAG_NO_MAPCHANGE|TIMER_REPEAT); 
	}
	else if (StrEqual(name,"round_start"))
	{	
		//Init stuff
		stFirstSpawnIndex = 0;			
		RegularTankId(0);		
		SpawnTimer_Init();		
		SetGameStatus(0,GAME_STATUS_SPAWN_LIMIT);
		
		if (L4D_IsFirstRound())
		{	
			//Zero Vectors
			for (int p = 0;p < MAX_TANK_PLAYERS;p++)
				flSavedFirstSpawns[p][0] = flSavedFirstSpawns[p][1] = flSavedFirstSpawns[p][2] = 0.0;												
		}
	}
	else if (StrEqual(name,"player_team"))
	{
		if (!CheckGameStatus(GAME_STATUS_IN_ROUND))
			return Plugin_Continue;
		
		//Don't call the ReplaceTankBot fx inside this event, an endless loop will begin and it "kills" all bot-tanks - all bot tanks will be replaced and removed one by one 
		iUserId			   = GetEventInt(event,"userid");
		int iTeamChangerId = GetClientOfUserId(iUserId);			
		if (event.GetInt("team") == L4D_TEAM_INFECTED && iTeamChangerId > 0 && IsClientInGame(iTeamChangerId) && !IsFakeClient(iTeamChangerId))
			RequestFrame(NextFrame_ReplaceTankBot,iUserId);
	}
	else if (StrEqual(name,"player_bot_replace")) //a player left the team / disconnected
	{
		if (!CheckGameStatus(GAME_STATUS_IN_ROUND))
			return Plugin_Continue;			
		
		int ibotId 		 = event.GetInt("bot");
		int ibotClientId = GetClientOfUserId(ibotId)
		
		if (GetClientTeam(ibotClientId) == L4D_TEAM_INFECTED)
		{
			iUserId = event.GetInt("player");		
			SpawnTimer_UnassignPlayerFromTimer(iUserId);
			
			if (iUserId == RegularTankId())
				RegularTankId(ibotId);	
			
			ChangeTanksName(ibotClientId);		
		}
	}
	else if (StrEqual(name,"round_end"))
	{
		SpawnTimer_Stop();
	}
	return Plugin_Continue;
}
//Replaces a bot with a human player
void NextFrame_ReplaceTankBot (int iUserId)
{
	int clientId = GetClientOfUserId(iUserId);
	if (clientId == 0 || GetClientTeam(clientId) != L4D_TEAM_INFECTED)
		return;
	
	for (int i = 1;i <= MaxClients;i++)
	{
		if (i != clientId && IsClientInGame(i) && IsFakeClient(i) && GetClientTeam(i) == L4D_TEAM_INFECTED && IsPlayerAlive(i))
		{				
			SDKCall(g_hTakeOverZombieBot, clientId, i);
			
			int iBotUserId = GetClientUserId(i);
			if (iBotUserId == RegularTankId())
				RegularTankId(iUserId);			
			
			return;
		}
	}
	//Not found? Assign the player to a running timer of a dead tank
	SpawnTimer_Create(ASSIGN_PLAYER_TO_BOT_TIMER,iUserId);
}

//stores and gets the regular tank's id
int RegularTankId (int iTanksUserId = -1) 
{
	static int st_iRegularId = -1;
	if(iTanksUserId > 0)
	{	
		st_iRegularId = iTanksUserId;
		int iTankId   = GetClientOfUserId(st_iRegularId);
		
		//Paints the regular tank usually in red (not in black)
		SetEntityRenderMode (iTankId,RENDER_TRANSCOLOR);
		SetEntityRenderColor(iTankId,REGULAR_TANK_COL[0],REGULAR_TANK_COL[1],REGULAR_TANK_COL[2],REGULAR_TANK_COL[3]);
		
		if (IsFakeClient(iTankId))
			SetClientInfo(iTankId,"name","Regular Tank");
	}
	else if (iTanksUserId == 0) //remove the current stored id
		st_iRegularId = -1;
	
	return st_iRegularId;
}
//Set a 'better' name for the bot!
void ChangeTanksName(int iTanksClientId)
{	
	static int st_iTankNameIdx = 0;
	
	ArrayList arrNamesList = view_as<ArrayList>(g_arrGameData.Get(GDIDX_TANK_NAMES_LIST));	
	if (st_iTankNameIdx == arrNamesList.Length)
		st_iTankNameIdx = 0;
	
	char sTankName[MAX_NAME_LENGTH+1]
	arrNamesList.GetString(st_iTankNameIdx++,sTankName,sizeof(sTankName));
	SetClientInfo(iTanksClientId,"name",sTankName);	
}
//There are fixed first spawn positions set for this map?
ArrayList FixedSpawnsAtStart() 
{
	ArrayList arrFixedSpawns = view_as<ArrayList>(g_arrGameData.Get(GDIDX_FIXED_SPAWNS_LIST));
	if (arrFixedSpawns == INVALID_HANDLE)
		return view_as<ArrayList>(INVALID_HANDLE);
	
	return view_as<ArrayList>(arrFixedSpawns.Get(0));
}
//Make sure that a witch spawns at the SAME position in both halfs, which is not fully guaranteed by engine or versus_witch_flow_team_variation 0.0
//It makes a difference in this gamemode if the witch spawns sitting in front of the house door in c8m1 or left or right from in the 2nd half.
public Action Events_WitchSpawn (Event event, const char[] name, bool dontBroadcast)
{
	if (!CheckGameStatus(GAME_STATUS_IN_ROUND))
		return Plugin_Continue;		
	
	static float flWitchSpawnPos[3];	
	if (StrEqual(name,"witch_spawn"))
	{	
		int witchid = event.GetInt("witchid");		
		if (!L4D_IsFirstRound ())
		{
			if (flWitchSpawnPos [0] != 0.0)
			{
				TeleportEntity(witchid,flWitchSpawnPos,NULL_VECTOR,NULL_VECTOR);
				flWitchSpawnPos [0] = 0.0;				
			}
			else //a witch has been spawned by engine (later in the game i.e.)
				AcceptEntityInput(witchid, "Kill"); 
		}
		else
			GetEntPropVector(witchid, Prop_Send, "m_vecOrigin", flWitchSpawnPos);
	}
	else if (StrEqual(name,"versus_round_start"))
	{
		if (!L4D_IsFirstRound () && flWitchSpawnPos [0] != 0.0)
			FakeCommand("z_spawn_old","witch");	
	}
	else if (StrEqual(name,"round_start"))
	{
		if (L4D_IsFirstRound())
			flWitchSpawnPos [0] = 0.0;
	}
	return Plugin_Continue;
}
//Hide the top panel in spec mode when a human tank is dead. Comes better than "Spawning has been disabled". Otherwise it results in "You are cheating!" blabla
public Action Event_VGUIMenu (UserMsg msg_id, Handle hBf, const int[] players, int playersNum, bool reliable, bool init)
{
	if (!IsClientInGame(players[0])
		||   IsFakeClient  (players[0])
	||   GetClientTeam (players[0]) != L4D_TEAM_INFECTED)
	return Plugin_Continue;
	
	char sName [256];
	BfReadString(hBf,sName,sizeof(sName));	
	bool bShowPanel = BfReadBool(hBf);	
	if (StrEqual(sName,"specgui") && bShowPanel)
		RequestFrame(NextFrame_HideSpecPanels,players[0]);
	
	return Plugin_Continue;
}
void NextFrame_HideSpecPanels (int clientId)
{
	if (!IsPlayerAlive(clientId))
		ShowVGUIPanel(clientId,"specgui",INVALID_HANDLE,false);
}

//when a player joined the survivors team, tell the player what their can do if incapped  (bot_player_replace, player_incapacitated)
public Action Events_PlayerIsIncapped (Event event, const char[] name, bool dontBroadcast)
{
	if (!CheckGameStatus(GAME_STATUS_IN_ROUND))
		return Plugin_Continue;
	
	int clientId = GetClientOfUserId(event.GetInt((StrEqual(name,"player_incapacitated") ? "userid" : "player")));	
	
	if (GetClientTeam(clientId) != L4D_TEAM_SURVIVORS 
		|| !L4D_IsIncapped(clientId))
	return Plugin_Continue;
	
	CPrintToChat(clientId,"%s %t",PLUGIN_TAG,"SurvivorSlayYourself", SLAY_COMMAND);
	
	if (g_gameoptions & GO_FLAG_ENABLE_CRAWLING) //Use a seperate line for this message now because of other languages (since v1.2)
		CPrintToChat(clientId,"%s %t",PLUGIN_TAG,"SurvivorSlayYourself_OrCrawl");
	
	return Plugin_Continue;
}

//Compares a given vector with well know bugged (stucked) map areas (see the file in the gamedata directory).
bool CheckVectorByBugList (ArrayList arrBugList, float flVector[3])
{
	static int iLittleRandomSpawnIndex = 0;
	float flValidSpawn, BetweenVectors[2];	
	bool bChangeVec = false;
	
	ArrayList arrDataSec;
	int iSpawnIdx;
	
	for (int a = 0,iArrItems = arrBugList.Length-1; a < iArrItems && !bChangeVec;a++)
	{
		arrDataSec = view_as<ArrayList>(arrBugList.Get(a++));
		for (int v = 0,i = 0;v < 3;v++)
		{					
			BetweenVectors[0] = view_as<float>(arrDataSec.Get(i++));
			BetweenVectors[1] = view_as<float>(arrDataSec.Get(i++));		
			
			if (!(bChangeVec = BetweenVectors [0] == 0.0 || (flVector[v] >= BetweenVectors[0] && flVector[v] <= BetweenVectors[1])))
				break;
		}	
		
		if (bChangeVec)
		{
			arrDataSec = view_as<ArrayList>(arrBugList.Get(a++));
			iSpawnIdx  = (arrDataSec.Length/3);				
			
			if (iLittleRandomSpawnIndex >= iSpawnIdx)
				iLittleRandomSpawnIndex = 0;
			
			iSpawnIdx = (iLittleRandomSpawnIndex*3);
			for (int s = 0;s < 3;s++)
			{
				flValidSpawn = view_as<float>(arrDataSec.Get(iSpawnIdx++));	
				
				if (flValidSpawn != 0.0) //change only valid float values
					flVector[s] = flValidSpawn;
			}		
			iLittleRandomSpawnIndex++;
			break;		
		}
	}
	return bChangeVec;	
}
//game commands - are not registred as console command and not necessary
public Action Events_Chat (int client, const char[] command, int argc) 
{   
	//Get chat Text
	char sChatMsg[128] = "";	
	if (GetCmdArg(1,sChatMsg,sizeof(sChatMsg)) == 0 || sChatMsg[0] != '!')
		return Plugin_Continue;
	
	if (StrEqual(sChatMsg[1],"ttcfg",false)) //Print the current config
	{			
		char sVer[8];
		GetConVarString(FindConVar("l4d2_tanktime_version"),sVer,sizeof(sVer));
		CPrintToChat(client,"%s-%t (Ver. %s)",PLUGIN_TAG,"ConfigInfo_Title",sVer);
		CPrintToChat(client,"- %t : %t","ConfigInfo_Bots",			  (g_gameoptions & GO_FLAG_ENABLE_BOTS)				  ? "ConfigInfo_Enabled"  : "ConfigInfo_Disabled"); 
		CPrintToChat(client,"- %t : %t","ConfigInfo_InfoPanel",		  (g_gameoptions & GO_FLAG_ENABLE_HUD)				  ? "ConfigInfo_Enabled"  : "ConfigInfo_Disabled");
		CPrintToChat(client,"- %t : %t","ConfigInfo_Crawling",		  (g_gameoptions & GO_FLAG_ENABLE_CRAWLING)	   		  ? "ConfigInfo_Enabled"  : "ConfigInfo_Disabled");
		CPrintToChat(client,"- %t : %t","ConfigInfo_TanksHealth",	  (g_gameoptions & GO_FLAG_HEALTH_INFO)				  ? "ConfigInfo_Enabled"  : "ConfigInfo_Disabled");
		CPrintToChat(client,"- %t : %t","ConfigInfo_RegularTanks",	  (g_gameoptions & GO_FLAG_DONT_ALLOW_REGULAR_TANKS)  ? "ConfigInfo_Disabled" : "ConfigInfo_Enabled");
		CPrintToChat(client,"- %t : %t","ConfigInfo_ShotgunMode",	  (g_gameoptions & GO_FLAG_ENABLE_SHOTGUN_MODE)  	  ? "ConfigInfo_Enabled"  : "ConfigInfo_Disabled");			
	}
	else if (IsPlayerAlive(client) && StrEqual(sChatMsg[1],SLAY_COMMAND,false))
	{
		if (GetClientTeam(client) == L4D_TEAM_SURVIVORS) //or let suicide incapped survivors - if it is their wish
		{
			if (L4D_IsIncapped(client))
			{
				ForcePlayerSuicide(client);
				CPrintToChatAllEx(client,"%s %t",PLUGIN_TAG,"SurvivorSlayedTheirself",client);
			}
			else
				CPrintToChat(client,"%s %t",PLUGIN_TAG,"SurvivorIsNotIncapped");
		}	
	}
	return Plugin_Handled;
}
void GameData_Free()
{
	GameData_FreeHandles(GDIDX_FIXED_SPAWNS_LIST);
	GameData_FreeHandles(GDIDX_BUGGED_AREAS_LIST);
	
	CloseHandle(g_arrGameData.Get(GDIDX_TANK_NAMES_LIST));
	g_arrGameData.Set(GDIDX_TANK_NAMES_LIST,INVALID_HANDLE);
	g_arrGameData.Set(GDIDX_SPAWN_LIMIT_AT_FINALE,false);
} 
void GameData_FreeHandles (int Index)
{
	ArrayList arrAy = view_as<ArrayList>(g_arrGameData.Get(Index));	
	if (arrAy == INVALID_HANDLE)
		return;
	
	Handle hItem;
	for (int i = 0, nItems = arrAy.Length;i < nItems;i++)
	{
		if ((hItem = arrAy.Get(i)) != INVALID_HANDLE)
			CloseHandle(hItem);	
	}
	
	delete arrAy;
	g_arrGameData.Set(Index,INVALID_HANDLE);
}
bool L4D_IsIncapped(int client) 
{
	return view_as<bool>(GetEntProp(client, Prop_Send, "m_isIncapacitated", 1));
}
bool L4D_IsIntroRunning() //GameRules_GetProp("m_bInIntro", 4, 0); <- doesn't work in the swamp fever intro and sometimes in other maps too
{
	if (CheckGameStatus(GAME_STATUS_IN_ROUND))
		return false;
	
	//Looking for a survivor 
	for (int s = 1;s <= MaxClients;s++)
	{
		if(IsClientInGame(s) && GetClientTeam(s) == L4D_TEAM_SURVIVORS)
		{
			float flSpawnPos[3];
			GetEntPropVector(s, Prop_Send, "m_vecOrigin", flSpawnPos)
			
			//Survivors get 0.0 coordinates with GetEntPropVector() while intros. This is not very smart but works.
			return view_as<bool>(flSpawnPos[0] == 0.0 && flSpawnPos[1] == 0.0);
		}
	}
	return false;
}
bool L4D_IsFirstRound()
{
	return !view_as<bool>(GameRules_GetProp("m_bInSecondHalfOfRound", 4, 0));
}
void FakeCommand (const char[] sCmd, const char[] sParam)
{
	int clientId = GetAClient();
	if (clientId == 0)
		return;
	
	int iFlags = GetCommandFlags(sCmd);
	SetCommandFlags(sCmd, iFlags ^ FCVAR_CHEAT); // Remove cheat flag
	FakeClientCommand(clientId,"%s %s",sCmd,sParam);
	SetCommandFlags(sCmd, iFlags); 
}
int GetAClient()
{ 
	static int CurPlayer = 1; //don't let one user (mainly) use the z_spawn_old command, some anti-flooding plugins could be alerted in some bad cases.....:-D
	for (int i = 1;i <= MaxClients;i++)
	{	
		if (IsClientInGame(CurPlayer) && !IsFakeClient(CurPlayer))
			return CurPlayer;
		
		if (++CurPlayer == MaxClients)
			CurPlayer = 1;
	}
	return 0;	
}
int FindEntityByTargetName (const char[] sEntity, const char[] sTargetName)
{
	char sNameBuff[56];
	int ent = -1;
	
	while ((ent = FindEntityByClassname(ent, sEntity)) != -1)
	{
		GetEntPropString(ent, Prop_Data, "m_iName", sNameBuff, sizeof(sNameBuff));
		if (StrEqual(sNameBuff, sTargetName))
			return ent;
	}
	return -1;
}
//***PARSE FILE*** : Read Map Bugs, Map Changes & glitches from l4d2_TankTime.txt file in the gamedata directory. Will usually be read at the first round_start-event.
bool WoodCutter_ParseGameFile (ArrayList arrGameData)
{
	char sFilePath[PLATFORM_MAX_PATH+1];
	BuildPath(Path_SM, sFilePath, sizeof(sFilePath), "gamedata/%s",TANKTIME_FILE);
	
	KeyValues kvWood = new KeyValues("TankTime");	
	if (!kvWood.ImportFromFile(sFilePath))
	{
		delete kvWood;
		ThrowParseError("File not found");
	}
	//Get Tank's alias Names
	if (!kvWood.JumpToKey("TankNames")
	|| 	!kvWood.GotoFirstSubKey(false))
	{
		delete kvWood;
		ThrowParseError("No Tank names were found");		
	}	
	
	ArrayList arrTankNames = new ArrayList(MAX_NAME_LENGTH+1);	
	char sTankName [MAX_NAME_LENGTH+1];
	do
	{
		kvWood.GetString(NULL_STRING,sTankName,sizeof(sTankName));
		
		if (strlen(sTankName) == 0)
			ThrowParseError("Empty Tank name found",TANKTIME_FILE);
		
		arrTankNames.PushString(sTankName);
		
	}while (kvWood.GotoNextKey(false));
	kvWood.Rewind();
	
	arrGameData.Set(GDIDX_TANK_NAMES_LIST,arrTankNames);
	//Look if the current map has well known bugs
	char sMapName[64];
	GetCurrentMap(sMapName,sizeof(sMapName));
	
	if (kvWood.JumpToKey(sMapName) == false)
	{
		delete kvWood;
		return true;
	}
	
	//Look if a spawn limit is set. Since the limit is removed for round_start it's just avaiable for the finale
	char value [32];
	kvWood.GetString("SpawnLimit",value,sizeof(value)); 
	if (strlen(value) > 0)
	{
		if (StrEqual(value,"Finale"))
			arrGameData.Set(GDIDX_SPAWN_LIMIT_AT_FINALE,true);
		else 
			ThrowParseError("Unknown SpawnLimit value");
	}
	
	ArrayList arrBuggedAreas = new ArrayList();
	arrGameData.Set(GDIDX_BUGGED_AREAS_LIST,arrBuggedAreas);
	
	//Start recursivly work
	WoodCutter_NextLevel(kvWood,1,0,arrGameData);
	
	if (arrBuggedAreas.Length == 0)
	{
		delete arrBuggedAreas;
		arrGameData.Set(GDIDX_BUGGED_AREAS_LIST,INVALID_HANDLE);
	}	
	delete kvWood;
	return true;
}

void WoodCutter_NextLevel(KeyValues kvWood, int Level, int Type, ArrayList arrGameData)
{
	char sSection[64];
	if (kvWood.GotoFirstSubKey() == false)
		return;
	
	do
	{		
		kvWood.GetSectionName(sSection,sizeof(sSection));		
		if (Level == 1)		
		{		
			if		(StrEqual(sSection,"SpawnBugs"))		  WoodCutter_NextLevel(kvWood,Level+1,1,arrGameData);	
			else if (StrEqual(sSection,"FixedFirstSpawnPos")) Array_WriteSpawnPosList(kvWood,"default",arrGameData.Get(GDIDX_FIXED_SPAWNS_LIST));
			else	 										  ThrowParseError("Invalid section found : %s",sSection);				
		}
		else if (Level == 2)
		{	
			if (Type == 1) //Bugged spawn areas
			{	
				ArrayList arrInvalidArea = new ArrayList();
				WriteFloatValues(kvWood,"InvalidArea",arrInvalidArea);	
				
				if ((arrInvalidArea.Length % 2) != 0)
					ThrowParseError("invalid area values found");
				
				arrGameData.Set(GDIDX_BUGGED_AREAS_LIST,view_as<Handle>(arrInvalidArea));				
				Array_WriteSpawnPosList(kvWood,"ValidSpawnPos",arrInvalidArea);
			}
		}
		
	}while (kvWood.GotoNextKey());
	kvWood.GoBack();
}
void ThrowParseError(const char[] sErrorMsg, any ...)
{
	char sOutMsg [512];
	VFormat(sOutMsg,sizeof(sOutMsg),sErrorMsg,2);
	
	LogError("%s (file %s in gamedata directory)",sOutMsg,TANKTIME_FILE);
	SetFailState("%s (file %s in gamedata directory)",sOutMsg,TANKTIME_FILE);
}
void WriteFloatValues (KeyValues kvWood, const char[] sStrKey, ArrayList arrSection)
{
	char sVecStr[64];		
	kvWood.GetString(sStrKey,sVecStr,sizeof(sVecStr));
	
	if (strlen(sVecStr) == 0)
		ThrowParseError("No values found in key %s",sVecStr);
	
	char sVecValues[3][64];
	if (ExplodeString(sVecStr,";",sVecValues,3,64) != 3)
		ThrowParseError("Invalid values found : %s",sStrKey);
	
	for (int v = 0;v < 3;v++)
	{
		if (StrContains(sVecValues[v],":") > -1) //area between Vec1:Vec2;
		{		
			char strBetweenVec[2][16];
			ExplodeString(sVecValues[v],":",strBetweenVec,2,16);
			
			float TwoVec[2];
			TwoVec[0] = StringToFloat(strBetweenVec[0]);
			TwoVec[1] = StringToFloat(strBetweenVec[1]);
			
			if (TwoVec[0] > TwoVec[1])
				ThrowParseError("Invalid float values found : %s",sStrKey);				
			
			arrSection.Push(view_as<any>(TwoVec[0]));
			arrSection.Push(view_as<any>(TwoVec[1]));			
		}
		else 
			arrSection.Push(StringToFloat(sVecValues[v]));		
	}
}
bool Array_WriteSpawnPosList (KeyValues kvWood, const char[] sKey, ArrayList arrAy)
{
	if (!kvWood.JumpToKey(sKey))
		return false;
	
	//Read valid vectors
	if (!kvWood.GotoFirstSubKey(false))
		ThrowParseError("No valid spawn points found");
	
	ArrayList arrSpawnList = new ArrayList();
	char sKeyBuff[8];	
	do
	{
		kvWood.GetSectionName(sKeyBuff,sizeof(sKeyBuff));
		WriteFloatValues(kvWood,NULL_STRING,arrSpawnList);
		
	}while (kvWood.GotoNextKey(false));
	kvWood.GoBack();
	
	if (view_as<Handle>(arrAy) == INVALID_HANDLE)
		arrAy = new ArrayList();
	
	arrAy.Push(view_as<Handle>(arrSpawnList));					
	kvWood.GoBack();
	return true;
}
